{
  "name": "heeranjid-prisma",
  "version": "0.5.0",
  "description": "Prisma client extension for HeeRanjID distributed ID generation (Postgres and MSSQL)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "build": "tsc",
    "prepack": "cp -r ../../../sql ./sql",
    "postpack": "rm -rf ./sql",
    "test": "vitest run"
  },
  "files": [
    "dist/",
    "src/",
    "sql/"
  ],
  "dependencies": {
    "heeranjid": "file:../"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": false
    }
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^2"
  }
}
